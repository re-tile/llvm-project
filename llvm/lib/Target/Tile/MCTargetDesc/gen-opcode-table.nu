#!/usr/bin/env nu
# Regenerates TileOpcodeTable.inc from a binutils source tree, the last one to
# carry TILE-Gx being 2.40. The table is the ISA as tile-as knows it: for every
# mnemonic the pipes it issues in, its operand fields and its fixed bits.
def main [binutils: path] {
  let header = open --raw ($binutils | path join include/opcode/tilegx.h)
  let source = open --raw ($binutils | path join opcodes/tilegx-opc.c)

  let fields = $header
    | parse --regex 'create_(?<name>\w+)\(int num\)\s*\{\s*const unsigned int n = \(unsigned int\)num;\s*return (?<body>[^;]*);'
    | each {|f|
      let chunks = $f.body
        | parse --regex '\(n & (?<mask>0x[0-9a-fA-F]+)\)\)*\s*(?:<<\s*(?<shift>\d+))?'
        | each {|c| {mask: $c.mask, shift: (if ($c.shift | is-empty) { "0" } else { $c.shift })} }
      {name: $f.name, chunks: $chunks}
    }
  let field_index = $fields | enumerate | each {|f| {($f.item.name): $f.index} } | into record

  let operand_body = $source
    | parse --regex 'tilegx_operands\[\d+\]\s*=\s*\{(?<body>[\s\S]*?)\n\};'
    | get 0.body
  let operands = $operand_body
    | str replace --all 'TILEGX_LOG2_BUNDLE_ALIGNMENT_IN_BYTES' '3'
    | parse --regex '\{\s*TILEGX_OP_TYPE_(?<type>\w+), BFD_RELOC\((?<reloc>\w+)\),\s*(?<bits>\d+), (?<signed>\d), (?<src>\d), (?<dest>\d), (?<pcrel>\d), (?<rshift>\d),\s*create_(?<field>\w+), get_\w+\s*\}'

  let opcode_body = $source
    | parse --regex 'tilegx_opcodes\[\d+\]\s*=\s*\{(?<body>[\s\S]*?)\n\};'
    | get 0.body
    | lines
    | where {|l| not ($l | str starts-with '#') }
    | str join "\n"
  let opcodes = $opcode_body
    | parse --regex '\{ "(?<name>[^"]+)", TILEGX_OPC_\w+, (?<pipes>0x[0-9a-f]+), (?<num>\d+), (?<implicit>\w+), (?<bundle>\d),\s*\{(?<ops>(?:\s*\{[^{}]*\},?)+)\s*\},\s*\{(?<masks>[^{}]*)\},\s*\{(?<values>[^{}]*)\}\s*\}'

  let sprs = $source
    | parse --regex 'tilegx_sprs\[\]\s*=\s*\{(?<body>[\s\S]*?)\n\};'
    | get 0.body
    | parse --regex '\{ (?<num>\d+), "(?<name>\w+)" \}'

  let reg = {TREG_ZERO: 63, TREG_LR: 55, TREG_SN: 56}

  let field_lines = $fields | each {|f|
    let chunks = $f.chunks | each {|c| $"{($c.mask)ULL, ($c.shift)}" } | str join ", "
    $"  {\"($f.name)\", ($f.chunks | length), {($chunks)}},"
  }
  let operand_lines = $operands | each {|o|
    let reloc = if $o.reloc == "NONE" { "ELF::R_TILEGX_NONE" } else { $"ELF::R_($o.reloc)" }
    $"  {OperandKind::($o.type | str lowercase | str capitalize), ($reloc), ($o.bits), ($o.signed), ($o.src), ($o.dest), ($o.pcrel), ($o.rshift), ($field_index | get $o.field)},"
  }
  let opcode_lines = $opcodes | each {|o|
    let ops = $o.ops
      | parse --regex '\{(?<list>[^{}]*)\}'
      | each {|g|
        let items = $g.list | split row ',' | str trim | where {|x| $x != "" }
        $"{($items | str join ', ')}"
      }
      | str join ", "
    let words = {|s| $s | split row ',' | str trim | where {|x| $x != "" } | each {|x| if $x == "-1ULL" { "~0ULL" } else { $x } } | str join ", " }
    let implicit = $reg | get $o.implicit
    $"  {\"($o.name)\", ($o.pipes), ($o.num), ($implicit), ($o.bundle), {($ops)}, {(do $words $o.masks)}, {(do $words $o.values)}},"
  }

  let out = [
    "// Generated by gen-opcode-table.nu from binutils 2.40 opcodes/tilegx-opc.c"
    "// and include/opcode/tilegx.h. Do not edit."
    ""
    "#ifdef TILE_FIELDS"
    ...$field_lines
    "#undef TILE_FIELDS"
    "#endif"
    ""
    "#ifdef TILE_OPERANDS"
    ...$operand_lines
    "#undef TILE_OPERANDS"
    "#endif"
    ""
    "#ifdef TILE_OPCODES"
    ...$opcode_lines
    "#undef TILE_OPCODES"
    "#endif"
    ""
    "#ifdef TILE_SPRS"
    ...($sprs | each {|r| $"  {($r.num), \"($r.name)\"}," })
    "#undef TILE_SPRS"
    "#endif"
  ]
  $out | str join "\n" | $in + "\n" | save --force ($env.FILE_PWD | path join TileOpcodeTable.inc)
  print $"fields=($fields | length) operands=($operands | length) opcodes=($opcodes | length) sprs=($sprs | length)"
}
